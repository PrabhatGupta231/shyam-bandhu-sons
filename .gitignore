# ============================================================
# Shyam Bandhu & Sons — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Environment / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS & Editor Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editor Directories ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log

# --- Runtime / Temp ---
*.tmp
*.temp
.cache/

# ============================================================
# NOT IGNORED (intentionally tracked):
#   public/            — gallery images, videos, logos
#   data/              — gallery.json, reels.json
#   *.html, *.js, *.css, *.json (root level)
# ============================================================
